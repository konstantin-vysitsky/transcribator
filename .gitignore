.venv/
__pycache__/
*.py[cod]
*.log
*.err
.pytest_cache/
.mypy_cache/

# Ключ доступа к сервису обработки текста. В config.json лежат только адрес и
# модель: сам ключ в репозиторий не попадает.
config.local.json
tests/снимки/

# Записи диктовки. Это голос человека, и в репозитории ему не место. Папка
# нужна как страховка: если распознавание не довели до текста, звук остаётся
# здесь и его можно достать руками.
записи/

# Снимки панели: проверка их пересобирает, в репозитории им не место.
tests/panel-*.png
tests/panel_*.png
tests/prompt_editor.png

# Пробные запуски и их тетради: черновики отладки окна на браузерном движке.
tests/probe*
tests/w[0-9]*
tests/kill_probes.py
tests/design-ref*.png
tests/ui-*.txt
tests/wiring-*.txt
tests/own*.png
tests/own*.txt
tests/shot-*.png
tests/side2.png
tests/vp*.png
tests/vp*.txt
tests/*-err.txt
tests/*-out.txt
tests/*-err2.txt
tests/*-out2.txt
tests/a3*.txt
tests/apt*.txt
tests/dr*.txt
tests/g2.txt
tests/jl-*.txt
tests/k2-out.txt
tests/k3-out.txt
tests/ml*.txt
tests/p[a-z]-*.txt
tests/p[a-z].txt
tests/ps*.txt
tests/pt-*.txt
tests/q2*.txt
tests/s2-*.txt
tests/st.txt
tests/look*.png
tests/during.png

# Кэш браузерного движка от пробных запусков.
.webview2-panel/
